Two ddt() terms in one contribution (AC)

ground 0

load "resistor.osdi"
load "twoddt.va"
load "oneddt.va"

model resistor resistor
model vsource vsource
model twoddt twoddt
model oneddt oneddt

// in -> device (r || 2c) -> out -> 1k -> ground, twice: two ddt() terms, and the control
v1 (in 0) vsource dc=0 mag=1
x2 (in out2) twoddt
r2 (out2 0) resistor r=1k
x1 (in out1) oneddt
r1 (out1 0) resistor r=1k

control
  abort always
  options rawfile="binary" reltol=1e-12 vntol=1e-15
  analysis ac1 ac from=1k to=1k mode="lin" points=1
  postprocess(PYTHON, "runme.py")
endc

embed "runme.py" <<<FILE
from rawfile import rawread
from runtest import *
import numpy as np
import sys

ac1 = rawread('ac1.raw').get()
f = ac1['frequency']
w = 2*np.pi*f
# analytic: Z = r || 1/(j w C), C = 2c = 100n; out = R2 / (R2 + Z)
z = 1.0/(1.0/1e3 + 1j*w*100e-9)
exact = 1e3/(1e3 + z)
tests = []
for node, what in (('out2', 'two ddt() terms'), ('out1', 'one ddt() term (control)')):
    v = ac1[node]
    ok = (relDiff(v, exact, 1e-12) < 1e-6).all()
    print("%-26s |v| = %.6f  phase = %.2f deg   expected %.6f at %.2f deg   %s" % (
        what, abs(v[0]), np.angle(v[0], deg=True), abs(exact[0]), np.angle(exact[0], deg=True),
        "ok" if ok else "WRONG"))
    tests.append(ok)
if isTest():
    sys.exit(not all(tests))
>>>FILE
