Bitwise not of an integer

ground 0

load "resistor.osdi"
load "bnot.va"
load "bnotp.va"

model resistor resistor
model bnot bnot
model bnotp bnotp
model vsource vsource

x1 (o1 0) bnot
r1 (o1 0) resistor r=1k
x2 (o2 0) bnotp
r2 (o2 0) resistor r=1k
// control: the same expression in VACASK's netlist language
parameters b=1000
v3 (o3 0) vsource dc=~b + 2001

control
  abort always
  options rawfile="binary"
  analysis op1 op
  postprocess(PYTHON, "runme.py")
endc

embed "runme.py" <<<FILE
from rawfile import rawread
from runtest import *
import sys

op1 = rawread('op1.raw').get()
tests = []
for node, what in (('o1', 'analog block: r = ~a + 2001'),
                   ('o2', 'parameter default: ~a + 2001'),
                   ('o3', 'netlist dc=~b + 2001 (control)')):
    v = op1[node][0]
    ok = abs(v - 1000.0) < 1e-9
    print("%-32s v = %.6g   expected 1000   %s" % (what, v, "ok" if ok else "WRONG"))
    tests.append(ok)
if isTest():
    sys.exit(not all(tests))
>>>FILE
